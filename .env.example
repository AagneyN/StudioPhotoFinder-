# Copy to .env and edit. Every value is optional; defaults are shown.
DATASET_ROOT=data/datasets/lfw
DATASET_NAME=lfw
EXECUTION_PROVIDER=auto        # auto | cpu | cuda  (auto falls back to CPU and reports why)
DETECTION_SCORE_THRESHOLD=0.6
MIN_FACE_SIZE_PX=40
MIN_FACE_QUALITY=0.3
# SIMILARITY_THRESHOLD=0.36    # leave unset; calibrate with scripts/evaluate_model.py (writes data/processed/calibration.json)
BATCH_SIZE=64
CHECKPOINT_EVERY=500
MAX_UPLOAD_MB=10
KEEP_UPLOADS=false             # uploaded query photos are deleted after the search unless true
UPLOAD_RETENTION_HOURS=24
API_HOST=127.0.0.1             # do NOT use 0.0.0.0 until authentication is added
API_PORT=8000
STREAMLIT_PORT=8501
LOG_LEVEL=INFO
